<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="proyectoTop.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:proyectoTop"
    xmlns:views="clr-namespace:proyectoTop.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="proyectoTop">

    <!--<ShellContent
    Title="Home"
    ContentTemplate="{DataTemplate local:MainPage}"
    Route="MainPage" />-->
    <FlyoutItem Title="Inicio" Icon="casa.png">
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate local:MainPage}"
            Route="MainPage" />
    </FlyoutItem>

    <FlyoutItem Title="Artistas" Icon="rock_start.png">
        <ShellContent
            Title="Artistas"
            ContentTemplate="{DataTemplate views:ListaArtistas}"
            Route="ListaArtistas" />
    </FlyoutItem>

</Shell>
