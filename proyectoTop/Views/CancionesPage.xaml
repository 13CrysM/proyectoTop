<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:proyectoTop.ViewModels"
             xmlns:models="clr-namespace:proyectoTop.Models"
             x:Class="proyectoTop.Views.CancionesPage"
             Title="Canciones"
             x:Name="ThisPage">
    <CollectionView ItemsSource="{Binding Canciones}">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Frame Margin="10" Padding="10" CornerRadius="10" HasShadow="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BindingContext.CancionSeleccionadaCommand, Source={x:Reference Name=ThisPage}}" 
                                              CommandParameter="{Binding .}" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*">
                        <Image Source="{Binding ImageUrl}" WidthRequest="80" HeightRequest="80" Aspect="AspectFit" />
                        <StackLayout Grid.Column="1" Padding="10,0">
                            <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold"/>
                            <Label Text="{Binding ReleaseYear, StringFormat='Año: {0}'}" FontSize="Medium" FontAttributes="Italic" />
                            <Label Text="{Binding Duration, StringFormat='Duración: {0}'}" FontSize="Medium" FontAttributes="Italic" />
                            <!--<Label Text="{Binding Lyrics}" />
                            <Image Source="boton_play.png" WidthRequest="20" HeightRequest="20" Aspect="AspectFill" />-->

                        </StackLayout>
                    </Grid>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>